{
  "name": "armoria",
  "description": "Heraldry generator and editor",
  "version": "1.1.0",
  "author": "Azgaar <azgaar.fmg@yandex.com>",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test:discord": "node --experimental-strip-types --test --test-isolation=none tests/discord.test.mjs",
    "test:api": "svelte-kit sync && node --test --test-isolation=none tests/api.test.mjs",
    "discord:register": "node --env-file-if-exists=.env scripts/register-discord.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "postinstall": "patch-package",
    "test:claims": "svelte-kit sync && node --test --test-isolation=none tests/claims.test.mjs",
    "test:render-limits": "svelte-kit sync && node --test --test-isolation=none tests/render-limits.test.mjs",
    "test:svg-upload": "node --test --test-isolation=none tests/svg-upload.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Azgaar/Armoria.git"
  },
  "keywords": [
    "heraldry",
    "svelte",
    "procedural-generation"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Azgaar/Armoria/issues"
  },
  "dependencies": {
    "@sparticuz/chromium-min": "138.0.1",
    "convert-svg-to-jpeg": "^0.7.1",
    "convert-svg-to-png": "^0.7.1",
    "dompurify": "^3.4.17",
    "minify-xml": "^4.5.2",
    "mongodb": "^6.17.0",
    "node-html-parser": "^7.0.1",
    "path-data-polyfill": "^1.0.10",
    "puppeteer-core": "24.11.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.22.5",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/eslint": "^9.6.1",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-svelte": "^3.10.1",
    "globals": "^16.3.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "puppeteer": "24.11.2",
    "svelte": "^4.2.7",
    "svelte-check": "^4.2.2",
    "svelte-i18n": "^4.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^5.0.3",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  },
  "type": "module"
}
