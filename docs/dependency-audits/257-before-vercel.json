{
  "routes": [
    {
      "src": ".*",
      "continue": true,
      "transforms": [
        {
          "type": "request.query",
          "op": "delete",
          "target": {
            "key": "__pathname"
          }
        }
      ]
    },
    {
      "src": "/_app/immutable/.+",
      "headers": {
        "cache-control": "public, immutable, max-age=31536000"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/_app/immutable/.+",
      "status": 404,
      "headers": {
        "cache-control": "no-store"
      },
      "continue": false
    },
    {
      "src": "^/api/?(?:/__data.json)?$",
      "dest": "/api"
    },
    {
      "src": "^/api/claims/([^/]+?)/?(?:/__data.json)?$",
      "dest": "/api/claims/[name]"
    },
    {
      "src": "^/api/claim/([^/]+?)/([^/]+?)(?:/([^/]+))?/?(?:/__data.json)?$",
      "dest": "/api/claim/[name]/[coa]/[[key]]"
    },
    {
      "src": "^/api/unclaim/([^/]+?)(?:/([^/]+))?/?(?:/__data.json)?$",
      "dest": "/api/unclaim/[name]/[[key]]"
    },
    {
      "src": "^/api/([^/]+?)/([^/]+?)(?:/([^/]+))?/?(?:/__data.json)?$",
      "dest": "/api/[format]/[size]/[[seed]]"
    },
    {
      "src": "^/discord/?(?:/__data.json)?$",
      "dest": "/discord"
    },
    {
      "src": "/.*",
      "dest": "/![-]/catchall"
    }
  ],
