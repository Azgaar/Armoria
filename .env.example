# For local type checking, these non-secret placeholders are sufficient.
# Replace them with your own credentials only when using database-backed features.
MONGO_ID=check
MONGO_PASS=check
# Optional claim administrator secret. Blank disables administrator access.
MASTER_KEY=
# Vercel runtime: Public Key from Discord Developer Portal > General Information.
DISCORD_PUBLIC_KEY=
# Optional override; defaults to the existing Vercel API.
ARMORIA_API_URL=https://armoria.vercel.app/api

# Local command registration only. The Vercel runtime does not need a bot token.
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
# Optional test server; leave unset to register globally.
DISCORD_GUILD_ID=
